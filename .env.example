# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Run `docker compose up -d` first.
DATABASE_URL="postgresql://crm:crm_dev_pw@localhost:5432/crm_b2b?schema=public"

# --- Auth -------------------------------------------------------------------
# Used to hash session tokens before they are stored. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-in-production"
# Session lifetime in hours (NF-01 session timeout).
SESSION_TTL_HOURS=8

# --- Server -----------------------------------------------------------------
PORT=3000
# Set to "false" on any process that must NOT run the cron sweeps.
# Only ONE process in a cluster may have this enabled.
ENABLE_CRON=true

# --- Seed -------------------------------------------------------------------
# Password given to all 8 seeded dev accounts. Dev only.
SEED_PASSWORD="ChangeMe123!"
