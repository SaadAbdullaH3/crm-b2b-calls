// CRM — B2B Calls : core schema
//
// Conventions
//   * Every model is @@map'd to a snake_case table name so raw SQL in the
//     build plan and in migrations matches the docs.
//   * Ownership rule (NF-07): a lead's CURRENT owner lives on `leads`
//     (status / assigned_to_id / locked_at / current_assignment_id) for fast
//     reads, while `lead_assignments` is an append-only history. The two are
//     always written together inside one transaction.
//   * `lead_assignments` additionally carries a PARTIAL UNIQUE INDEX added by
//     hand in the migration SQL — see the model for details. Do not drop it.
//
// Ownership split: models under "DEV B TERRITORY" are framed out so nothing
// is blocked on Day 2; Dev B owns their final shape (see GLOBAL.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum LeadStatus {
  AVAILABLE
  ASSIGNED
  IN_PROGRESS
  CALLBACK_SCHEDULED
  CLOSED_QUALIFIED
  CLOSED_NOT_INTERESTED
  DO_NOT_CALL
}

/// The 6 outcomes required by the SRS. Stored as a stable code on `calls` and
/// denormalized onto `leads.last_disposition_code` for the logout-return rule.
enum DispositionCode {
  NO_ANSWER
  CALL_BACK_LATER
  NOT_INTERESTED
  DO_NOT_CALL
  EMAIL
  QUALIFIED
}

enum AssignmentMethod {
  REQUEST_APPROVED
  AUTO_ASSIGN
  MANUAL
  REASSIGN
}

enum ReleaseReason {
  LOGOUT_RETURN
  REASSIGNED
  RELEASED_BY_MANAGEMENT
  COMPLETED
  ADMIN_OVERRIDE
}

enum LeadRequestStatus {
  PENDING
  APPROVED
  MODIFIED
  REJECTED
  AUTO_ASSIGNED
  EXPIRED
  CANCELLED
}

enum RequestQuantitySource {
  PRESET_15
  PRESET_30
  CUSTOM
}

enum ImportStatus {
  UPLOADED
  MAPPING
  VALIDATING
  PENDING_REVIEW
  IMPORTING
  COMPLETED
  FAILED
}

/// Verdict for one parsed row of an import file (LM-03/LM-04/LM-05).
enum ImportRowStatus {
  /// Clean: no duplicate, no missing information, phone format valid.
  READY
  /// Matches a lead already in the database, or an earlier row in this file.
  DUPLICATE
  /// A required-ish field is blank. The row is kept, not discarded.
  MISSING_INFO
  /// Phone number failed the U.S. FORMAT check (LM-05). Format only — we never
  /// check whether the number is live or reachable.
  INVALID_PHONE
  /// More than one of the above.
  INVALID
}

/// Management's decision for a detected duplicate (LM-06, actioned on Day 3).
enum DuplicateResolution {
  PENDING
  REJECT
  KEEP_BOTH
  UPDATE_EXISTING
  MANUAL_REVIEW
}

enum CallbackStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// HR-05. Kept an enum rather than free text so the leave report can group
/// reliably — "Sick"/"sick"/"Sick leave" typed by three people is three
/// categories in a report and one in reality.
enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  CASUAL
  BEREAVEMENT
  OTHER
}

/// HR-02. The SRS names undertakings, agreements, warning letters and
/// performance reviews explicitly, then allows "other authorized HR
/// documents" — hence OTHER rather than a free-text column.
enum HrDocumentType {
  UNDERTAKING
  AGREEMENT
  CONTRACT
  WARNING_LETTER
  PERFORMANCE_REVIEW
  ID_PROOF
  CERTIFICATE
  OTHER
}

/// HR-06 — the employment-history timeline.
enum HrEventType {
  JOINED
  CONFIRMED
  PROMOTION
  ROLE_CHANGE
  WARNING
  PERFORMANCE_REVIEW
  COMMENDATION
  PROBATION
  EXIT
  NOTE
}

enum ConversationType {
  DIRECT
  GROUP
  BROADCAST
}

/// What a user is doing right now, per TM-03/TM-04. Exactly one of these is
/// true at a time, and elapsed time accrues to the matching bucket on
/// `work_sessions`.
enum WorkSessionState {
  /// Qualifying activity seen within the inactivity window.
  ACTIVE
  /// TM-03: no qualifying activity for `monitoring.inactivityMinutes`.
  IDLE
  /// TM-04: the agent put themselves on break. Neither active nor idle.
  BREAK
  /// Signed out, session expired, or swept. No further time accrues.
  ENDED
}

/// Who an announcement reaches (CM-06). ROLE and GROUP are resolved to
/// concrete users at publish time so later membership changes don't silently
/// alter who was required to acknowledge.
enum AnnouncementAudience {
  ALL
  ROLE
  GROUP
}

/// Input type of an Admin-defined dynamic lead field (AD-05). Drives both the
/// form control rendered in the UI and the coercion applied when Dev A's
/// importer maps a spreadsheet column onto the field.
enum LeadFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTISELECT
  EMAIL
  PHONE
  URL
}

// ===========================================================================
// AUTH & RBAC
// ===========================================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  employeeCode String?   @unique @map("employee_code")
  phone        String?
  roleId       String    @map("role_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])

  sessions              Session[]
  leadsAssigned         Lead[]                       @relation("LeadAssignedTo")
  leadsMarkedDnc        Lead[]                       @relation("LeadDncBy")
  imports               LeadImport[]
  assignmentsHeld       LeadAssignment[]             @relation("AssignmentHolder")
  assignmentsMade       LeadAssignment[]             @relation("AssignmentActor")
  leadRequests          LeadRequest[]                @relation("RequestAgent")
  leadRequestsReviewed  LeadRequest[]                @relation("RequestReviewer")
  calls                 Call[]
  callbacks             Callback[]
  notifications         Notification[]
  activityEvents        ActivityEvent[]
  auditEntries          AuditLog[]
  messagesSent          Message[]                    @relation("MessageSender")
  conversations         ConversationParticipant[]    @relation("ConversationMember")
  conversationsCreated  Conversation[]               @relation("ConversationCreator")
  announcementsMade     Announcement[]
  announcementsReceived AnnouncementRecipient[]      @relation("AnnouncementRecipient")
  acknowledgements      AnnouncementAcknowledgement[]
  hrEmployee            HrEmployee?
  leaveRequests         LeaveRequest[]               @relation("LeaveRequester")
  leaveRequestsReviewed LeaveRequest[]               @relation("LeaveReviewer")
  reportsGenerated      ReportGenerated[]
  scoresReceived        ManagementScore[]            @relation("ScoreSubject")
  scoresGiven           ManagementScore[]            @relation("ScoreAuthor")

  // --- Dev B, Day 5: HR Module -------------------------------------------
  hrDocumentsUploaded HrDocument[]      @relation("HrDocumentUploader")
  hrEventsRecorded    HrEmployeeEvent[] @relation("HrEventRecorder")
  holidaysCreated     Holiday[]         @relation("HolidayCreator")

  // --- Dev B, Day 4: Monitoring Engine -----------------------------------
  workSessions WorkSession[] @relation("WorkSessionUser")
  breaks       BreakPeriod[] @relation("BreakUser")

  // --- Dev B, Day 2: Admin Configuration ---------------------------------
  groupMemberships GroupMember[]         @relation("GroupMembership")
  groupsCreated    Group[]               @relation("GroupCreator")
  groupMembersAdded GroupMember[]        @relation("GroupMemberAdder")
  settingsUpdated  SystemSetting[]       @relation("SettingUpdater")
  leadFieldsCreated LeadFieldDefinition[] @relation("FieldCreator")

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

/// Server-side session record. Logout and expiry are real events here, which is
/// what the LA-09 logout-return rule and Dev B's monitoring engine hang off.
model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Dev B, Day 4: TM-01 screen time accrues against this session.
  workSession WorkSession?

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

// ===========================================================================
// DEV A — CORE CALLING PIPELINE
// ===========================================================================

model LeadImport {
  id               String       @id @default(cuid())
  fileName         String       @map("file_name")
  storedPath       String?      @map("stored_path")
  uploadedById     String       @map("uploaded_by_id")
  sourceLabel      String?      @map("source_label")
  status           ImportStatus @default(UPLOADED)
  /// Header names read from the uploaded sheet, in column order (LM-02).
  detectedColumns  Json?        @map("detected_columns")
  /// Detected-column -> CRM-field map chosen by Management (LM-02).
  columnMapping    Json?        @map("column_mapping")
  totalRows        Int          @default(0) @map("total_rows")
  validRows        Int          @default(0) @map("valid_rows")
  duplicateRows    Int          @default(0) @map("duplicate_rows")
  missingInfoRows  Int          @default(0) @map("missing_info_rows")
  invalidPhoneRows Int          @default(0) @map("invalid_phone_rows")
  importedRows     Int          @default(0) @map("imported_rows")
  errorReportPath  String?      @map("error_report_path")
  startedAt        DateTime?    @map("started_at")
  completedAt      DateTime?    @map("completed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  uploadedBy User            @relation(fields: [uploadedById], references: [id])
  leads      Lead[]
  rows       LeadImportRow[]

  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
  @@map("lead_imports")
}

/// One parsed row of an uploaded sheet, with its validation verdict.
///
/// Rows are NEVER discarded during analysis (LM-04): a row with problems is
/// stored and flagged so Management can see it, decide per-duplicate on Day 3
/// (LM-06 reject / keep both / update existing / manual review), and export the
/// error report. Only rows that survive that review become `leads`.
model LeadImportRow {
  id        String @id @default(cuid())
  importId  String @map("import_id")
  /// 1-based position in the sheet, excluding the header row, so the number
  /// shown to Management matches what they see in Excel.
  rowNumber Int    @map("row_number")

  /// Mapped values keyed by CRM field name. Fixed `leads` columns use their
  /// Prisma field name; Admin-defined dynamic fields use their `key` and end up
  /// in `leads.custom_fields`.
  data Json

  status ImportRowStatus @default(READY)
  /// Machine-readable issue codes (e.g. ["MISSING_PHONE","INVALID_PHONE_FORMAT"]),
  /// so the Day 3 error export can render a reason per row without re-analysing.
  issues Json?

  /// Set when this row matches a lead already in the database.
  duplicateOfLeadId String? @map("duplicate_of_lead_id")
  /// Set when this row duplicates an EARLIER row in the same file.
  duplicateOfRowNumber Int? @map("duplicate_of_row_number")
  /// Which fields matched, e.g. ["phoneE164","email"] — shown to Management so
  /// they can judge whether it is really the same company.
  duplicateMatchedOn Json? @map("duplicate_matched_on")

  /// Management's per-duplicate decision (LM-06). Day 3 sets this.
  resolution DuplicateResolution @default(PENDING)
  /// The lead this row produced, once the import is committed.
  importedLeadId String? @map("imported_lead_id")

  createdAt DateTime @default(now()) @map("created_at")

  import          LeadImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  duplicateOfLead Lead?      @relation("ImportRowDuplicateOf", fields: [duplicateOfLeadId], references: [id], onDelete: SetNull)
  importedLead    Lead?      @relation("ImportRowImported", fields: [importedLeadId], references: [id], onDelete: SetNull)

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@index([duplicateOfLeadId])
  @@map("lead_import_rows")
}

model Lead {
  id String @id @default(cuid())

  // --- mapped business fields ---------------------------------------------
  companyName String? @map("company_name")
  contactName String? @map("contact_name")
  jobTitle    String? @map("job_title")
  phoneRaw    String? @map("phone_raw")
  /// Normalized at import. LM-05 is FORMAT validation only — we never check
  /// that a number is live or reachable.
  phoneE164   String? @map("phone_e164")
  email       String?
  website     String?
  addressLine String? @map("address_line")
  city        String?
  state       String?
  postalCode  String? @map("postal_code")
  /// Values for Admin-defined dynamic fields (Dev B's field builder).
  customFields Json?  @map("custom_fields")
  sourceLabel String? @map("source_label")
  importId    String? @map("import_id")

  // --- ownership + lock block (VICIdial-style lead hopper) ------------------
  status              LeadStatus @default(AVAILABLE)
  assignedToId        String?    @map("assigned_to_id")
  lockedAt            DateTime?  @map("locked_at")
  /// Points at the open row in lead_assignments. Kept in step with
  /// assigned_to_id inside the same transaction; the partial unique index on
  /// lead_assignments is what makes a second open row impossible.
  currentAssignmentId String?    @unique @map("current_assignment_id")

  // --- follow-up state (drives the LA-09 logout-return rule) ---------------
  lastDispositionCode DispositionCode? @map("last_disposition_code")
  lastDispositionAt   DateTime?        @map("last_disposition_at")
  nextCallbackAt      DateTime?        @map("next_callback_at")
  callAttempts        Int              @default(0) @map("call_attempts")

  // --- sticky protections (survive reassignment) ---------------------------
  doNotCall     Boolean   @default(false) @map("do_not_call")
  doNotCallAt   DateTime? @map("do_not_call_at")
  doNotCallById String?   @map("do_not_call_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  import            LeadImport?     @relation(fields: [importId], references: [id])
  assignedTo        User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  doNotCallBy       User?           @relation("LeadDncBy", fields: [doNotCallById], references: [id])
  currentAssignment LeadAssignment? @relation("LeadCurrentAssignment", fields: [currentAssignmentId], references: [id])

  assignments LeadAssignment[] @relation("LeadAssignmentHistory")
  calls       Call[]
  callbacks   Callback[]

  importRowsDuplicateOf LeadImportRow[] @relation("ImportRowDuplicateOf")
  importRowsImported    LeadImportRow[] @relation("ImportRowImported")

  @@index([status, assignedToId])
  @@index([assignedToId])
  // Duplicate-detection lookups (Day 2). Deliberately NOT unique: "keep both"
  // is a valid duplicate resolution on Day 3.
  @@index([phoneE164])
  @@index([email])
  @@index([companyName])
  @@index([nextCallbackAt])
  @@index([importId])
  @@index([doNotCall])
  @@map("leads")
}

/// APPEND-ONLY assignment history. Rows are never deleted, and no column is
/// ever updated except released_at / release_reason when ownership ends.
///
/// released_at IS NULL  ==>  this row is the lead's current holder.
///
/// The migration adds, by hand:
///   CREATE UNIQUE INDEX lead_assignments_one_active_holder
///     ON lead_assignments (lead_id) WHERE released_at IS NULL;
/// That partial index is the database-level guarantee against double
/// assignment (NF-07). Prisma cannot express it, so it lives in raw SQL and
/// must be preserved through every future migration.
model LeadAssignment {
  id            String           @id @default(cuid())
  leadId        String           @map("lead_id")
  assignedToId  String           @map("assigned_to_id")
  /// Null when the system assigned it (5-minute auto-assign job).
  assignedById  String?          @map("assigned_by_id")
  method        AssignmentMethod
  requestId     String?          @map("request_id")
  assignedAt    DateTime         @default(now()) @map("assigned_at")
  releasedAt    DateTime?        @map("released_at")
  releaseReason ReleaseReason?   @map("release_reason")
  notes         String?

  lead       Lead         @relation("LeadAssignmentHistory", fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User         @relation("AssignmentHolder", fields: [assignedToId], references: [id])
  assignedBy User?        @relation("AssignmentActor", fields: [assignedById], references: [id])
  request    LeadRequest? @relation(fields: [requestId], references: [id])

  currentForLead Lead?  @relation("LeadCurrentAssignment")
  calls          Call[]

  @@index([leadId, releasedAt])
  @@index([assignedToId, releasedAt])
  @@index([requestId])
  @@index([assignedAt])
  @@map("lead_assignments")
}

/// An agent's request for more leads (LA-02/LA-03). Management approves,
/// rejects or modifies it; if untouched for 5 minutes the cron job assigns
/// automatically — `auto_assign_at` is that job's only query predicate.
model LeadRequest {
  id                String                @id @default(cuid())
  agentId           String                @map("agent_id")
  quantityRequested Int                   @map("quantity_requested")
  quantitySource    RequestQuantitySource @map("quantity_source")
  status            LeadRequestStatus     @default(PENDING)
  quantityApproved  Int?                  @map("quantity_approved")
  quantityAssigned  Int                   @default(0) @map("quantity_assigned")
  reviewedById      String?               @map("reviewed_by_id")
  reviewedAt        DateTime?             @map("reviewed_at")
  reviewNote        String?               @map("review_note")
  /// created_at + 5 minutes. The auto-assign sweep selects on this.
  autoAssignAt      DateTime              @map("auto_assign_at")
  resolvedAt        DateTime?             @map("resolved_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  agent       User             @relation("RequestAgent", fields: [agentId], references: [id])
  reviewedBy  User?            @relation("RequestReviewer", fields: [reviewedById], references: [id])
  assignments LeadAssignment[]

  @@index([status, autoAssignAt])
  @@index([agentId, status])
  @@index([createdAt])
  @@map("lead_requests")
}

/// Configuration/lookup table for call outcomes. The 6 SRS outcomes are seeded
/// with is_system = true so Admin cannot delete them (they can be relabelled).
model Disposition {
  id               String          @id @default(cuid())
  code             DispositionCode @unique
  label            String
  description      String?
  /// Marks the outcome as an active follow-up: leads holding one of these stay
  /// with the agent through logout instead of returning to the pool (LA-10).
  isFollowUp       Boolean         @default(false) @map("is_follow_up")
  /// Forces a callback date/time to be captured (Call Back Later).
  requiresCallback Boolean         @default(false) @map("requires_callback")
  /// Sets leads.do_not_call and blocks normal calling/reassignment.
  blocksCalling    Boolean         @default(false) @map("blocks_calling")
  isSystem         Boolean         @default(false) @map("is_system")
  isActive         Boolean         @default(true) @map("is_active")
  sortOrder        Int             @default(0) @map("sort_order")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  calls Call[]

  @@map("dispositions")
}

/// One call attempt. Populated from Day 5; the VC Dialer fields exist now so
/// wiring the real dialer on Day 9 needs no migration (CL-04).
model Call {
  id            String    @id @default(cuid())
  leadId        String    @map("lead_id")
  agentId       String    @map("agent_id")
  assignmentId  String?   @map("assignment_id")
  dispositionId String?   @map("disposition_id")
  notes         String?
  startedAt     DateTime? @map("started_at")
  endedAt       DateTime? @map("ended_at")
  durationSec   Int?      @map("duration_sec")
  phoneDialed   String?   @map("phone_dialed")
  /// How the call was placed: DIALER or CLIPBOARD fallback (CL-03).
  channel       String    @default("CLIPBOARD")
  recordingRef  String?   @map("recording_ref")
  dialerCallId  String?   @map("dialer_call_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  lead        Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent       User            @relation(fields: [agentId], references: [id])
  assignment  LeadAssignment? @relation(fields: [assignmentId], references: [id])
  disposition Disposition?    @relation(fields: [dispositionId], references: [id])
  callbacks   Callback[]

  @@index([leadId, createdAt])
  @@index([agentId, createdAt])
  @@index([dispositionId])
  @@map("calls")
}

model Callback {
  id           String         @id @default(cuid())
  leadId       String         @map("lead_id")
  agentId      String         @map("agent_id")
  callId       String?        @map("call_id")
  scheduledFor DateTime       @map("scheduled_for")
  status       CallbackStatus @default(SCHEDULED)
  notes        String?
  completedAt  DateTime?      @map("completed_at")
  /// When the CL-07 reminder was sent. Guards the cron sweep against
  /// re-notifying the same callback every minute until it is actioned.
  remindedAt   DateTime?      @map("reminded_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent User  @relation(fields: [agentId], references: [id])
  call  Call? @relation(fields: [callId], references: [id])

  @@index([agentId, status, scheduledFor])
  @@index([leadId])
  @@index([scheduledFor])
  @@map("callbacks")
}

// ===========================================================================
// SHARED PLUMBING — Dev A writes to these from Day 3 / Day 8
// ===========================================================================

/// Append-only. Never updated, never deleted (AU-01..AU-03).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  /// Value before the change, for the fields that changed.
  before     Json?
  /// Value after the change, for the same fields.
  after      Json?
  summary    String?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String?
  payload   Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model ActivityEvent {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  type       String
  payload    Json?
  occurredAt DateTime @default(now()) @map("occurred_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([type])
  @@map("activity_events")
}

// ===========================================================================
// DEV B TERRITORY — framed out so nothing is blocked on Day 2.
// Dev B owns the final shape of everything below (see GLOBAL.md).
// ===========================================================================

// ---------------------------------------------------------------------------
// Admin Configuration (Dev B, Day 2) — AD-03, AD-05, AD-06/07/08/09
// ---------------------------------------------------------------------------

/// A named set of users (AD-03). Also the addressing unit for group messages
/// and broadcasts on Day 3 (CM-05) — "B2B Team", "Senior Agents", "Training".
model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// Seeded groups an Admin may rename but not delete.
  isSystem    Boolean  @default(false) @map("is_system")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy     User?          @relation("GroupCreator", fields: [createdById], references: [id])
  members       GroupMember[]
  conversations Conversation[]
  announcements Announcement[]

  @@map("groups")
}

model GroupMember {
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  addedById String?  @map("added_by_id")
  addedAt   DateTime @default(now()) @map("added_at")

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User  @relation("GroupMembership", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User? @relation("GroupMemberAdder", fields: [addedById], references: [id])

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

/// Key/value configuration store backing AD-06 (dialer), AD-07 (inactivity
/// threshold, shifts, break rules), AD-08 (notification categories) and AD-09
/// (report settings).
///
/// Deliberately key/value + Json rather than a column per setting: adding a new
/// setting must never require a migration, and the Monitoring Engine reads its
/// 5-minute threshold from here rather than hard-coding it (TM-03).
///
/// `isSecret` marks values that must never be returned through an API — dialer
/// credentials are write-only from the UI's point of view (AD-06).
model SystemSetting {
  key         String   @id
  category    String
  value       Json
  isSecret    Boolean  @default(false) @map("is_secret")
  description String?
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("SettingUpdater", fields: [updatedById], references: [id])

  @@index([category])
  @@map("system_settings")
}

/// Admin-defined dynamic lead field (AD-05). The definition lives here; the
/// per-lead VALUE lives in `leads.custom_fields` keyed by `key`, so adding a
/// field never migrates the leads table.
///
/// Dev A's import column-mapper reads the active rows here to offer targets
/// beyond the fixed business columns on `leads`.
model LeadFieldDefinition {
  id    String        @id @default(cuid())
  /// The property name used inside `leads.custom_fields`. Immutable once rows
  /// reference it — renaming would orphan every stored value.
  key   String        @unique
  label String
  type  LeadFieldType @default(TEXT)

  isRequired Boolean @default(false) @map("is_required")
  /// Soft delete: definitions are deactivated, never dropped, so historical
  /// leads keep rendering values for retired fields.
  isActive   Boolean @default(true) @map("is_active")
  /// Choice list for SELECT / MULTISELECT — a JSON array of strings.
  options    Json?
  helpText   String? @map("help_text")
  sortOrder  Int     @default(0) @map("sort_order")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User? @relation("FieldCreator", fields: [createdById], references: [id])

  @@index([isActive, sortOrder])
  @@map("lead_field_definitions")
}

// ---------------------------------------------------------------------------
// Monitoring Engine (Dev B, Day 4) — TM-01, TM-03, TM-04, TM-06
// ---------------------------------------------------------------------------

/// TM-01 — one row per signed-in auth session, accumulating screen time.
///
/// Keyed 1:1 to Dev A's `sessions` row rather than to the user, because that
/// is what makes "screen time" a real measurement: the session already has a
/// definite start (login) and end (logout, revoke or expiry), and Dev A's
/// lead-return rules key off exactly the same lifecycle.
///
/// Time is ACCUMULATED, not derived from an event log. Each heartbeat adds the
/// elapsed interval since `lastHeartbeatAt` to whichever bucket the current
/// `state` names, then moves the marker. A month of monitoring is therefore a
/// few hundred rows rather than millions of heartbeats, and a report reads
/// counters instead of replaying history.
model WorkSession {
  id        String @id @default(cuid())
  sessionId String @unique @map("session_id")
  userId    String @map("user_id")

  state WorkSessionState @default(ACTIVE)

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  /// Marker for the accumulator: everything before this instant has already
  /// been counted into one of the buckets below.
  lastHeartbeatAt DateTime @default(now()) @map("last_heartbeat_at")
  /// Last moment qualifying activity was actually seen. TM-03 compares this,
  /// not `lastHeartbeatAt` — a heartbeat proves the tab is open, not that
  /// anyone is working.
  lastActivityAt  DateTime @default(now()) @map("last_activity_at")

  // --- accumulated buckets, milliseconds (TM-05: Management-only) ----------
  activeMs Int @default(0) @map("active_ms")
  idleMs   Int @default(0) @map("idle_ms")
  breakMs  Int @default(0) @map("break_ms")

  /// How many times this session went idle. A shift that flickered idle 40
  /// times reads very differently from one that idled once over lunch.
  idleCount  Int @default(0) @map("idle_count")
  breakCount Int @default(0) @map("break_count")

  session Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User          @relation("WorkSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  breaks  BreakPeriod[]

  @@index([userId, startedAt])
  @@index([state])
  // The idle sweep's hot query: open sessions whose activity has gone stale.
  @@index([state, lastActivityAt])
  @@map("work_sessions")
}

/// TM-04 — one row per break, kept separately from `work_sessions.breakMs` so
/// Management can see WHEN breaks were taken and how long each ran, not just a
/// daily total. MG-07's punctuality report needs the individual periods.
model BreakPeriod {
  id            String    @id @default(cuid())
  workSessionId String    @map("work_session_id")
  userId        String    @map("user_id")
  startedAt     DateTime  @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")
  durationMs    Int?      @map("duration_ms")
  reason        String?
  /// True when the break was closed by logout or the sweep rather than by the
  /// agent pressing "end break" — an unclosed break is a data-quality signal,
  /// not a 9-hour lunch.
  autoClosed    Boolean   @default(false) @map("auto_closed")

  workSession WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  user        User        @relation("BreakUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([workSessionId])
  @@map("break_periods")
}

// ---------------------------------------------------------------------------
// Communication (Dev B, Day 3)
// ---------------------------------------------------------------------------

/// A messaging thread. DIRECT is a 1:1 conversation between two users;
/// GROUP is many-to-many (optionally mirroring an AD-03 `groups` row);
/// BROADCAST is one Management/HR sender fanned out to many recipients who
/// reply privately rather than to the whole list (CM-02).
///
/// Replaces the Day 1 `thread_key` + per-message recipient frame. Unread state
/// lives on the PARTICIPANT (`lastReadAt`), not on every message row, so an
/// unread count is one indexed comparison instead of a per-message join.
model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType @default(DIRECT)
  /// Null for DIRECT — the title is the other participant's name.
  title     String?
  /// Set when a GROUP conversation mirrors an AD-03 group.
  groupId   String?          @map("group_id")
  /// Canonical key for DIRECT conversations: the two user ids sorted and
  /// joined, "idA:idB". Null for GROUP and BROADCAST.
  ///
  /// The unique constraint is what makes a duplicate DM thread impossible.
  /// find-then-create is not atomic: two concurrent requests (a double-clicked
  /// "New message", or a broadcast racing a manual DM) can both see no thread
  /// and both create one, silently splitting the conversation in two. Same
  /// reasoning as Dev A's `lead_assignments_one_active_holder` — the database
  /// is the guarantee, the application code is just the fast path.
  pairKey   String?          @unique @map("pair_key")
  createdById String         @map("created_by_id")
  /// Denormalized from the newest message so the inbox list can sort without
  /// touching `messages` at all.
  lastMessageAt DateTime?    @map("last_message_at")
  createdAt DateTime         @default(now()) @map("created_at")

  group        Group?                    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy    User                      @relation("ConversationCreator", fields: [createdById], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@index([type, lastMessageAt])
  @@index([groupId])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  /// CM-07 read state. Everything sent after this is unread for this user.
  lastReadAt     DateTime? @map("last_read_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  /// Leaving hides the thread without destroying history for anyone else.
  leftAt         DateTime? @map("left_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ConversationMember", fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, leftAt])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  body           String
  sentAt         DateTime @default(now()) @map("sent_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  // CM-07 searchable history: newest-first within a thread.
  @@index([conversationId, sentAt])
  @@index([senderId, sentAt])
  @@map("messages")
}

/// CM-06 announcements. `audience` records the INTENT; `recipients` records
/// who it actually reached, resolved at publish time. Keeping both matters for
/// acknowledgement tracking: if an announcement targeted "all agents" and an
/// agent joins next week, they were never required to acknowledge it, and the
/// outstanding list must not suddenly grow a name.
model Announcement {
  id                      String               @id @default(cuid())
  authorId                String               @map("author_id")
  title                   String
  body                    String
  audience                AnnouncementAudience @default(ALL)
  /// Role name when audience = ROLE.
  audienceRole            String?              @map("audience_role")
  /// Group id when audience = GROUP.
  audienceGroupId         String?              @map("audience_group_id")
  requiresAcknowledgement Boolean              @default(false) @map("requires_acknowledgement")
  publishedAt             DateTime             @default(now()) @map("published_at")

  author           User                          @relation(fields: [authorId], references: [id])
  audienceGroup    Group?                        @relation(fields: [audienceGroupId], references: [id], onDelete: SetNull)
  recipients       AnnouncementRecipient[]
  acknowledgements AnnouncementAcknowledgement[]

  @@index([publishedAt])
  @@map("announcements")
}

/// The resolved audience, frozen at publish time. One row per user who was
/// meant to see this announcement.
model AnnouncementRecipient {
  announcementId String @map("announcement_id")
  userId         String @map("user_id")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("AnnouncementRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_recipients")
}

model AnnouncementAcknowledgement {
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@map("announcement_acknowledgements")
}

/// HR-01 - the employment record for one user.
///
/// Employee id, name, email and phone deliberately live on `users` and are NOT
/// duplicated here: two copies of a phone number is two answers to "what is
/// their phone number". This table holds only what is true of the EMPLOYMENT
/// rather than of the login.
model HrEmployee {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  department  String?
  designation String?
  /// HR-01 shift. Free text ("09:00-18:00", "Night"). The authoritative
  /// working window for punctuality lives in `shift.config` (AD-07); this is
  /// the human label on the contract.
  shift          String?
  employmentType String?   @map("employment_type")
  joinedAt       DateTime? @map("joined_at")
  /// End of probation, if used.
  confirmedAt    DateTime? @map("confirmed_at")
  /// Set when employment ends. The row is retained - HR-06 history and any
  /// audit trail must survive someone leaving.
  exitedAt       DateTime? @map("exited_at")

  managerName           String?   @map("manager_name")
  dateOfBirth           DateTime? @map("date_of_birth")
  address               String?
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  notes                 String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents HrDocument[]
  events    HrEmployeeEvent[]

  @@index([exitedAt])
  @@map("hr_employees")
}

/// HR-02/HR-03 - a stored employee document plus the metadata the SRS
/// requires: type, upload date, uploader, employee, notes, optional expiry.
///
/// `storedPath` points OUTSIDE the web root (`/uploads`, gitignored) and the
/// file on disk is named by this row id, never by the uploaded filename - a
/// client-supplied name is an attacker-supplied path. The original name is
/// kept in `fileName` only so a download can restore it.
///
/// The file is never served statically. Every read goes through a route that
/// checks permission first; a guessable static URL would make HR-07
/// meaningless.
model HrDocument {
  id         String         @id @default(cuid())
  employeeId String         @map("employee_id")
  docType    HrDocumentType @default(OTHER) @map("doc_type")

  /// The name the uploaded file had. Display and download only.
  fileName   String  @map("file_name")
  storedPath String  @map("stored_path")
  mimeType   String? @map("mime_type")
  sizeBytes  Int?    @map("size_bytes")

  /// HR-03 optional expiry/renewal date - visas, certifications, contracts.
  expiresAt    DateTime? @map("expires_at")
  notes        String?
  uploadedById String    @map("uploaded_by_id")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")

  employee   HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation("HrDocumentUploader", fields: [uploadedById], references: [id])

  @@index([employeeId, docType])
  @@index([expiresAt])
  @@map("hr_documents")
}

/// HR-06 - employment history: warnings, reviews, promotions, role changes.
///
/// Append-only in practice. A warning that can be quietly deleted is not a
/// record, and an exit review months later depends on this being complete.
model HrEmployeeEvent {
  id         String      @id @default(cuid())
  employeeId String      @map("employee_id")
  type       HrEventType
  title      String
  details    String?
  /// When the event took effect, which is not always when it was recorded.
  effectiveDate DateTime @map("effective_date")

  recordedById String   @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  employee   HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recordedBy User       @relation("HrEventRecorder", fields: [recordedById], references: [id])

  @@index([employeeId, effectiveDate])
  @@index([type])
  @@map("hr_employee_events")
}

/// HR-05 - the holiday calendar.
///
/// Separate from `leave_requests`: a public holiday applies to everyone and
/// nobody requests it, so modelling it as an approved leave row per employee
/// would be both wrong and N rows per holiday.
model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  /// Falls on the same calendar date every year. A moving holiday gets one
  /// row per year instead.
  isRecurring Boolean  @default(false) @map("is_recurring")
  description String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User? @relation("HolidayCreator", fields: [createdById], references: [id])

  @@unique([name, date])
  @@index([date])
  @@map("holidays")
}

model LeaveRequest {
  id           String      @id @default(cuid())
  requesterId  String      @map("requester_id")
  leaveType    LeaveType   @default(ANNUAL) @map("leave_type")
  startDate    DateTime    @map("start_date")
  endDate      DateTime    @map("end_date")
  /// Working days requested, computed at submission from the configured
  /// working days and the holiday calendar. Stored rather than derived so a
  /// later change to either does not silently rewrite history.
  days         Int         @default(1)
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById String?     @map("reviewed_by_id")
  reviewedAt   DateTime?   @map("reviewed_at")
  /// HR-05 "comments" - the reviewer note, shown to the requester.
  reviewComment String?    @map("review_comment")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  requester  User  @relation("LeaveRequester", fields: [requesterId], references: [id])
  reviewedBy User? @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([requesterId, status])
  @@index([status, startDate])
  @@map("leave_requests")
}

model ReportGenerated {
  id            String   @id @default(cuid())
  generatedById String   @map("generated_by_id")
  reportType    String   @map("report_type")
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  filters       Json?
  storedPath    String?  @map("stored_path")
  createdAt     DateTime @default(now()) @map("created_at")

  generatedBy User @relation(fields: [generatedById], references: [id])

  @@index([reportType, createdAt])
  @@map("reports_generated")
}

model ManagementScore {
  id          String   @id @default(cuid())
  subjectId   String   @map("subject_id")
  authorId    String   @map("author_id")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  score       Int
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subject User @relation("ScoreSubject", fields: [subjectId], references: [id])
  author  User @relation("ScoreAuthor", fields: [authorId], references: [id])

  @@index([subjectId, periodStart])
  @@map("management_scores")
}
